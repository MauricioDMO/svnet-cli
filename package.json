{
  "name": "svnet-cli",
  "version": "0.1.0",
  "description": "Consulta disponibilidad y WHOIS de dominios .sv desde Bun o la terminal",
  "type": "module",
  "exports": "./src/index.ts",
  "bin": {
    "svnet": "./bin/svnet.ts"
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun bin/svnet.ts",
    "test": "bun test",
    "build": "bun build --compile ./bin/svnet.ts --outfile dist/svnet",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "entities": "^8.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
